# LNMP Docker 模板环境变量示例
# 复制为 `.env` 后根据注释改成你的实际值

# 基本参数
PROJECT_NAME=my_lnmp              # 项目标识(容器名前缀)；仅字母/数字/下划线
BASE_DOMAIN=localhost            # 你的域名或本机用 localhost
WEB_PORT=80                      # 映射到宿主机的 HTTP 端口

# 版本选择
PHP_VERSION=8.2                  # PHP 次版本 (如 8.2 / 8.3)
NGINX_VERSION=1.25               # Nginx 主版本 (如 1.25)

# 数据库
DB_ENGINE=mysql                  # 可选: mysql 或 mariadb
DB_VERSION=8.0                   # 对应数据库版本; MariaDB 示例: 10.11
DB_HOST=db                       # 应用内部连接主机名(通常不改)
DB_PORT=3306                     # 映射到宿主机的端口
DB_NAME=appdb                    # 你的业务数据库名(请修改)
DB_USER=appuser                  # 你的数据库用户(请修改)
DB_PASSWORD=app_pass             # 你的数据库密码(请修改)
DB_ROOT_PASSWORD=root_pass       # Root 密码(请修改, 勿用默认!)

# MySQL 5.x 可改为 mysql_native_password；8.x 使用 caching_sha2_password
MYSQL_DEFAULT_AUTH_PLUGIN=caching_sha2_password

# 本地化 & 调试
TZ=Asia/Shanghai                 # 时区，如 Asia/Shanghai
XDEBUG_MODE=off                  # 开发时可设为 develop,debug；线上请 off

# 可选: Redis
REDIS_PORT=6379                  # Redis 映射端口(如启用服务)

